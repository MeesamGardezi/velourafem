<% const pageTitle = 'Philosophy — ' + content.brand.name; %>
<% const pageDescription = 'What we believe in and how we approach fashion.'; %>
<%- include('partials/shop-head') %>

<%- include('partials/nav') %>

<main class="shop-main">
  <!-- Breadcrumb -->
  <nav class="breadcrumb shop-breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">
      <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 2l4 4-4 4"/></svg>
    </span>
    <span class="breadcrumb-current">Philosophy</span>
  </nav>

  <!-- Page Hero -->
  <section class="shop-hero-header">
    <div class="shop-hero-bg">
      <div class="shop-hero-grain"></div>
      <div class="shop-hero-orb shop-hero-orb-1"></div>
      <div class="shop-hero-orb shop-hero-orb-2"></div>
    </div>
    <div class="shop-hero-content">
      <p class="section-eyebrow center"><%= content.philosophy.eyebrow %></p>
      <h1 class="shop-title"><%= content.philosophy.title %> <em class="script-heading"><%= content.philosophy.titleAccent %></em></h1>
      <p class="shop-hero-subtitle"><%= content.philosophy.subtitle %></p>
    </div>
  </section>

  <!-- Philosophy Content -->
  <section class="legal-content philosophy-page">
    <div class="legal-inner">

      <div class="philosophy-intro">
        <p>We started PAKNITS because we were tired of fashion that shouts. Everything out there felt like it was competing for attention — louder prints, bigger logos, faster trends. We wanted the opposite. Clothes that let the person wearing them do the talking.</p>
        <p>That's really what this brand comes down to. We make things we'd actually want to wear, for people who already know what they like and don't need anyone to tell them what's cool.</p>
      </div>

      <div class="philosophy-pillars">
        <% content.philosophy.pillars.forEach(function(pillar) { %>
          <div class="philosophy-pillar">
            <span class="pillar-icon"><%= pillar.icon %></span>
            <h3><%= pillar.title %></h3>
            <p><%= pillar.body %></p>
          </div>
        <% }); %>
      </div>

      <div class="philosophy-closing">
        <h2>How we actually work</h2>
        <div class="process-steps">
          <% content.process.steps.forEach(function(step) { %>
            <div class="process-step">
              <span class="step-num"><%= step.num %></span>
              <h3><%= step.title %></h3>
              <p><%= step.body %></p>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="philosophy-cta">
        <p>Enough reading — go see for yourself.</p>
        <a href="/products" class="btn btn-terracotta">Browse the Collection</a>
      </div>

    </div>
  </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/shop-foot') %>
