<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Brands — Admin — paknits</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Instrument+Sans:wght@0,400;0,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body no-loader">
  <% const activePage = 'brands'; %>
  <%- include('../partials/admin-nav') %>

  <div class="admin-content">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Brands</h1>
        <p class="admin-page-sub">Manage the brands you resell — displayed in the Visual Diary on the homepage</p>
      </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="admin-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="admin-error"><%= error %></div>
    <% } %>

    <!-- Add / Edit Brand Form -->
    <div class="admin-catalogue-upload">
      <h2 class="admin-form-section-title"><%= (typeof editing !== 'undefined' && editing) ? 'Edit Brand' : 'Add New Brand' %></h2>
      <form action="/admin/brands/<%= (typeof editing !== 'undefined' && editing) ? editing.id + '/edit' : 'new' %>" method="POST" enctype="multipart/form-data" class="admin-brand-form">
        <div class="admin-brand-form-grid">
          <div class="form-group">
            <label for="brand-name">Brand Name <span class="required">*</span></label>
            <input type="text" id="brand-name" name="name" required placeholder="e.g. Khaadi, Sapphire" value="<%= (typeof editing !== 'undefined' && editing) ? editing.name : '' %>">
          </div>
          <div class="form-group">
            <label for="brand-website">Website URL</label>
            <input type="url" id="brand-website" name="website" placeholder="https://brand.com" value="<%= (typeof editing !== 'undefined' && editing) ? editing.website : '' %>">
          </div>
          <div class="form-group">
            <label for="brand-scrape-url">Product Feed URL <span style="font-weight:400;opacity:0.6;">(for auto-fetch)</span></label>
            <input type="url" id="brand-scrape-url" name="scrapeUrl" placeholder="https://brand.com/collections/all" value="<%= (typeof editing !== 'undefined' && editing) ? (editing.scrapeUrl || '') : '' %>">
            <p class="admin-upload-hint">URL of the page listing products — scraped daily at 2 AM</p>
          </div>
          <div class="form-group">
            <label for="brand-color">Card Color</label>
            <select id="brand-color" name="color">
              <% ['green','ivory','dark','blush','celadon','sage','taupe'].forEach(function(c) { %>
                <option value="<%= c %>" <%= (typeof editing !== 'undefined' && editing && editing.color === c) ? 'selected' : '' %>><%= c.charAt(0).toUpperCase() + c.slice(1) %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group admin-brand-full">
            <label for="brand-desc">Description</label>
            <textarea id="brand-desc" name="description" rows="3" placeholder="Short description of the brand…"><%= (typeof editing !== 'undefined' && editing) ? editing.description : '' %></textarea>
          </div>
          <div class="form-group">
            <label for="brand-logo">Brand Banner</label>
            <input type="file" id="brand-logo" name="logo" accept="image/*" class="admin-file-input">
            <p class="admin-upload-hint">Recommended: landscape image (e.g. 760×500)</p>
            <% if (typeof editing !== 'undefined' && editing && editing.logo) { %>
              <p class="admin-upload-hint">Current banner set — upload a new one to replace it</p>
            <% } %>
          </div>
        </div>
        <div style="display:flex;gap:12px;margin-top:20px;">
          <button type="submit" class="btn btn-terracotta"><%= (typeof editing !== 'undefined' && editing) ? 'Update Brand' : 'Add Brand' %></button>
          <% if (typeof editing !== 'undefined' && editing) { %>
            <a href="/admin/brands" class="btn btn-secondary">Cancel</a>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Existing Brands -->
    <div class="admin-catalogues-list" style="margin-top:40px;">
      <h2 class="admin-form-section-title">All Brands (<%= brands.length %>)</h2>

      <div style="display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap;">
        <% if (brands.some(function(b) { return b.scrapeUrl; })) { %>
          <button type="button" class="btn btn-secondary" onclick="fetchAll(this)">⟳ Fetch All Brand Products Now</button>
        <% } %>
        <% if (brands.length) { %>
          <button type="button" class="btn btn-secondary" style="color:#c0392b;border-color:#c0392b;" onclick="if(confirm('⚠ DELETE ALL <%= brands.length %> BRANDS? This cannot be undone.'))postAction('/admin/brands/delete-all')">Delete All Brands</button>
        <% } %>
      </div>

      <div class="admin-bulk-bar" id="bulkBar" style="display:none;">
        <span class="admin-bulk-count"><span id="bulkCount">0</span> selected</span>
        <button type="button" class="btn btn-secondary admin-bulk-delete-btn" onclick="bulkDelete()">Delete Selected</button>
        <button type="button" class="btn btn-secondary" onclick="clearSelection()">Cancel</button>
      </div>

      <% if (brands.length === 0) { %>
        <div class="admin-empty-state">
          <span class="admin-empty-icon">🏷</span>
          <p>No brands added yet. Add your first brand above.</p>
        </div>
      <% } else { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th class="admin-th-check"><input type="checkbox" id="selectAll" onchange="toggleAll(this)"></th>
                <th>Banner</th>
                <th>Name</th>
                <th>Color</th>
                <th>Feed URL</th>
                <th>Description</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% brands.forEach(function(b) { %>
                <tr>
                  <td class="admin-td-check"><input type="checkbox" value="<%= b.id %>" class="row-check" onchange="updateBulkBar()"></td>
                  <td>
                    <% if (b.logo) { %>
                      <img src="<%= b.logo %>" alt="<%= b.name %>" class="admin-table-img" style="object-fit:contain;background:#f5f0e8;border-radius:8px;">
                    <% } else { %>
                      <div class="admin-brand-placeholder">🏷</div>
                    <% } %>
                  </td>
                  <td class="admin-table-title"><%= b.name %></td>
                  <td><span class="admin-tag"><%= b.color %></span></td>
                  <td class="admin-brand-desc-cell">
                    <% if (b.scrapeUrl) { %>
                      <span style="color:#2d6a4f;" title="<%= b.scrapeUrl %>">✓ Set</span>
                    <% } else { %>
                      <span style="color:#999;">—</span>
                    <% } %>
                  </td>
                  <td class="admin-brand-desc-cell"><%= b.description ? b.description.substring(0,60) + (b.description.length > 60 ? '…' : '') : '—' %></td>
                  <td class="admin-actions">
                    <% if (b.scrapeUrl) { %>
                      <button type="button" class="admin-btn-edit" onclick="fetchOne(this,'<%= b.id %>')">⟳ Fetch</button>
                    <% } %>
                    <a href="/admin/brands/<%= b.id %>/edit" class="admin-btn-edit">Edit</a>
                    <button type="button" class="admin-btn-delete" onclick="if(confirm('Delete this brand?'))postAction('/admin/brands/<%= b.id %>/delete')">Delete</button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

<form id="actionForm" method="POST" style="display:none"></form>

<script>
function postAction(url) {
  var f = document.getElementById('actionForm');
  f.action = url;
  f.innerHTML = '';
  f.submit();
}

function fetchOne(btn, id) {
  btn.textContent = 'Fetching…';
  btn.disabled = true;
  postAction('/admin/brands/' + id + '/fetch');
}

function fetchAll(btn) {
  btn.textContent = 'Fetching…';
  btn.disabled = true;
  postAction('/admin/brands/fetch-all');
}

function toggleAll(master) {
  document.querySelectorAll('.row-check').forEach(function(cb) { cb.checked = master.checked; });
  updateBulkBar();
}

function updateBulkBar() {
  var checked = document.querySelectorAll('.row-check:checked');
  var all = document.querySelectorAll('.row-check');
  document.getElementById('bulkCount').textContent = checked.length;
  document.getElementById('bulkBar').style.display = checked.length > 0 ? 'flex' : 'none';
  var sa = document.getElementById('selectAll');
  sa.checked = all.length > 0 && checked.length === all.length;
  sa.indeterminate = checked.length > 0 && checked.length < all.length;
}

function bulkDelete() {
  var checked = document.querySelectorAll('.row-check:checked');
  if (!checked.length) return;
  if (!confirm('Delete ' + checked.length + ' selected brand(s)? This cannot be undone.')) return;
  var f = document.getElementById('actionForm');
  f.action = '/admin/brands/bulk-delete';
  f.innerHTML = '';
  checked.forEach(function(cb) {
    var inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = 'ids'; inp.value = cb.value;
    f.appendChild(inp);
  });
  f.submit();
}

function clearSelection() {
  document.querySelectorAll('.row-check').forEach(function(cb) { cb.checked = false; });
  document.getElementById('selectAll').checked = false;
  updateBulkBar();
}
</script>
</body>
</html>