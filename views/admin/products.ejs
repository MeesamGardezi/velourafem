<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products — Admin — paknits</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Instrument+Sans:wght@0,400;0,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body no-loader">
  <% const activePage = 'products'; %>
  <%- include('../partials/admin-nav') %>

  <div class="admin-content">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Products</h1>
        <p class="admin-page-sub"><%= products.length %> total products</p>
      </div>
      <div style="display:flex;gap:10px;align-items:center;">
        <% if (products.length) { %>
          <button type="button" class="btn btn-secondary" style="color:#c0392b;border-color:#c0392b;" onclick="if(confirm('⚠ DELETE ALL <%= products.length %> PRODUCTS? This cannot be undone.'))postAction('/admin/products/delete-all')">Delete All</button>
        <% } %>
        <a href="/admin/products/new" class="btn btn-terracotta">+ Add Product</a>
      </div>
    </div>

    <% if (success) { %>
      <div class="admin-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="admin-error"><%= error %></div>
    <% } %>

    <div class="admin-bulk-bar" id="bulkBar" style="display:none;">
      <span class="admin-bulk-count"><span id="bulkCount">0</span> selected</span>
      <button type="button" class="btn btn-secondary admin-bulk-delete-btn" onclick="bulkDelete()">Delete Selected</button>
      <button type="button" class="btn btn-secondary" onclick="clearSelection()">Cancel</button>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th class="admin-th-check"><input type="checkbox" id="selectAll" onchange="toggleAll(this)"></th>
            <th>Image</th>
            <th>Title</th>
            <th>Category</th>
            <th>Price</th>
            <th>Badge</th>
            <th>Featured</th>
            <th>Stock</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (products.length === 0) { %>
            <tr><td colspan="9" class="admin-empty-row">No products yet. <a href="/admin/products/new">Add one →</a></td></tr>
          <% } else { %>
            <% products.forEach(function(p) { %>
              <tr>
                <td class="admin-td-check"><input type="checkbox" value="<%= p.id %>" class="row-check" onchange="updateBulkBar()"></td>
                <td><img src="<%= p.image %>" alt="<%= p.title %>" class="admin-table-img"></td>
                <td class="admin-table-title"><strong><%= p.title %></strong><br><small class="admin-table-meta"><%= p.meta %></small></td>
                <td><span class="admin-tag"><%= p.category %></span></td>
                <td><%= usd(p.price) %></td>
                <td><span class="badge badge--<%= p.badgeStyle %>"><%= p.badge %></span></td>
                <td><span class="admin-bool-<%= p.featured ? 'yes' : 'no' %>"><%= p.featured ? '★ Yes' : '— No' %></span></td>
                <td><span class="admin-stock-badge admin-stock-<%= p.inStock ? 'in' : 'out' %>"><%= p.inStock ? 'In Stock' : 'Out of Stock' %></span></td>
                <td class="admin-actions">
                  <a href="/admin/products/<%= p.id %>/edit" class="admin-btn-edit">Edit</a>
                  <button type="button" class="admin-btn-delete" onclick="if(confirm('Delete \'<%= p.title.replace(/'/g, "\\'") %>\'?'))postAction('/admin/products/<%= p.id %>/delete')">Delete</button>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

<form id="actionForm" method="POST" style="display:none"></form>

<script>
function postAction(url) {
  var f = document.getElementById('actionForm');
  f.action = url;
  f.innerHTML = '';
  f.submit();
}

function toggleAll(master) {
  document.querySelectorAll('.row-check').forEach(function(cb) { cb.checked = master.checked; });
  updateBulkBar();
}

function updateBulkBar() {
  var checked = document.querySelectorAll('.row-check:checked');
  var all = document.querySelectorAll('.row-check');
  document.getElementById('bulkCount').textContent = checked.length;
  document.getElementById('bulkBar').style.display = checked.length > 0 ? 'flex' : 'none';
  var sa = document.getElementById('selectAll');
  sa.checked = all.length > 0 && checked.length === all.length;
  sa.indeterminate = checked.length > 0 && checked.length < all.length;
}

function bulkDelete() {
  var checked = document.querySelectorAll('.row-check:checked');
  if (!checked.length) return;
  if (!confirm('Delete ' + checked.length + ' selected product(s)? This cannot be undone.')) return;
  var f = document.getElementById('actionForm');
  f.action = '/admin/products/bulk-delete';
  f.innerHTML = '';
  checked.forEach(function(cb) {
    var inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = 'ids'; inp.value = cb.value;
    f.appendChild(inp);
  });
  f.submit();
}

function clearSelection() {
  document.querySelectorAll('.row-check').forEach(function(cb) { cb.checked = false; });
  document.getElementById('selectAll').checked = false;
  updateBulkBar();
}
</script>
</body>
</html>