<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product ? 'Edit' : 'Add' %> Product — Admin — paknits</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Instrument+Sans:wght@0,400;0,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body no-loader">
  <% const activePage = 'products'; %>
  <%- include('../partials/admin-nav') %>

  <div class="admin-content">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title"><%= product ? 'Edit Product' : 'Add New Product' %></h1>
        <p class="admin-page-sub"><%= product ? 'Update product details' : 'Fill in the details to list a new product' %></p>
      </div>
      <a href="/admin/products" class="btn btn-secondary">← Back to Products</a>
    </div>

    <% if (error) { %>
      <div class="admin-error"><%= error %></div>
    <% } %>

    <form
      action="/admin/products/<%= product ? product.id + '/edit' : 'new' %>"
      method="POST"
      enctype="multipart/form-data"
      class="admin-form"
    >
      <div class="admin-form-grid">
        <!-- Left Column -->
        <div class="admin-form-col">
          <div class="admin-form-section">
            <h2 class="admin-form-section-title">Basic Information</h2>

            <div class="form-group">
              <label for="title">Product Title <span class="required">*</span></label>
              <input type="text" id="title" name="title" required value="<%= product ? product.title : '' %>" placeholder="e.g. Velvet Drape">
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="category">Category</label>
                <select id="category" name="category">
                  <% ['Dresses', 'Tops', 'Outerwear', 'Sets', 'Bottoms', 'Accessories'].forEach(function(cat) { %>
                    <option value="<%= cat %>" <%= product && product.category === cat ? 'selected' : '' %>><%= cat %></option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label for="price">Price (USD) <span class="required">*</span></label>
                <input type="number" id="price" name="price" required min="0" step="0.01" value="<%= product ? product.price : '' %>" placeholder="24500">
              </div>
            </div>

            <div class="form-group">
              <label for="brand">Brand</label>
              <select id="brand" name="brand" onchange="document.getElementById('brandId').value = this.options[this.selectedIndex].dataset.brandid || ''">
                <option value="" data-brandid="">— No brand —</option>
                <% if (typeof brands !== 'undefined' && brands.length) { %>
                  <% brands.forEach(function(b) { %>
                    <option value="<%= b.name %>" data-brandid="<%= b.id %>" <%= product && (product.brand === b.name || product.brandId === b.id) ? 'selected' : '' %>><%= b.name %></option>
                  <% }); %>
                <% } %>
              </select>
              <input type="hidden" id="brandId" name="brandId" value="<%= product && product.brandId ? product.brandId : '' %>">
              <p class="form-hint">Select the brand this product belongs to</p>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="productType">Product Type</label>
                <select id="productType" name="productType">
                  <option value="">— Select —</option>
                  <% ['Stitched', 'Unstitched', 'Ready to Wear', 'Pret', 'Luxury Pret', 'Formal', 'Bridal', 'Casual'].forEach(function(pt) { %>
                    <option value="<%= pt %>" <%= product && product.productType === pt ? 'selected' : '' %>><%= pt %></option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label for="fabric">Fabric</label>
                <input type="text" id="fabric" name="fabric" value="<%= product ? (product.fabric || '') : '' %>" placeholder="e.g. Lawn, Chiffon, Silk">
              </div>
            </div>

            <div class="form-group">
              <label for="tags">Tags</label>
              <input type="text" id="tags" name="tags" value="<%= product && product.tags ? (Array.isArray(product.tags) ? product.tags.join(', ') : product.tags) : '' %>" placeholder="e.g. Women, Eid Collection, Luxury">
              <p class="form-hint">Comma-separated tags (e.g. Women, Men, Formal, Eid Collection)</p>
            </div>

            <div class="form-group">
              <label for="meta">Meta Line</label>
              <input type="text" id="meta" name="meta" value="<%= product ? product.meta : '' %>" placeholder="e.g. Emerald · Bespoke">
            </div>

            <div class="form-group">
              <label for="desc">Short Description</label>
              <textarea id="desc" name="desc" rows="3" placeholder="Brief description shown on cards…"><%= product ? product.desc : '' %></textarea>
            </div>

            <div class="form-group">
              <label for="details">Full Details</label>
              <textarea id="details" name="details" rows="4" placeholder="Materials, care instructions, sizing…"><%= product ? product.details : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div class="admin-form-col">
          <div class="admin-form-section">
            <h2 class="admin-form-section-title">Images</h2>

            <div class="form-group">
              <label>Current Images</label>
              <% const allImages = (product && product.images && product.images.length) ? product.images : (product && product.image ? [product.image] : []); %>
              <% if (allImages.length) { %>
                <div class="admin-images-grid" id="existingImages">
                  <% allImages.forEach(function(img, idx) { %>
                    <div class="admin-image-thumb" data-idx="<%= idx %>">
                      <img src="<%= img %>" alt="Image <%= idx + 1 %>">
                      <button type="button" class="admin-image-remove" onclick="removeExistingImage(this, <%= idx %>)" title="Remove">&times;</button>
                      <% if (idx === 0) { %><span class="admin-image-primary">Primary</span><% } %>
                    </div>
                  <% }); %>
                </div>
                <input type="hidden" id="removedImages" name="removedImages" value="">
                <input type="hidden" id="existingImagesData" name="existingImages" value="<%= JSON.stringify(allImages) %>">
              <% } else { %>
                <p class="form-hint" style="margin-top:0;">No images yet.</p>
              <% } %>
            </div>

            <div class="form-group">
              <label for="images">Add Images</label>
              <input type="file" id="images" name="images" accept="image/*" multiple class="admin-file-input">
              <p class="form-hint">JPG, PNG, WebP. Max 10MB each. Select multiple files. First image becomes primary if no existing images.</p>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="badge">Badge Label</label>
                <input type="text" id="badge" name="badge" value="<%= product ? product.badge : '' %>" placeholder="e.g. New Arrival">
              </div>
              <div class="form-group">
                <label for="badgeStyle">Badge Color</label>
                <select id="badgeStyle" name="badgeStyle">
                  <% ['green', 'terracotta', 'muted'].forEach(function(s) { %>
                    <option value="<%= s %>" <%= product && product.badgeStyle === s ? 'selected' : '' %>><%= s %></option>
                  <% }); %>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="color">Card Color Theme</label>
              <select id="color" name="color">
                <% ['green', 'sage', 'taupe', 'dark', 'blush', 'celadon'].forEach(function(c) { %>
                  <option value="<%= c %>" <%= product && product.color === c ? 'selected' : '' %>><%= c %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="admin-form-section">
            <h2 class="admin-form-section-title">Status</h2>
            <div class="admin-toggle-row">
              <label class="admin-toggle-label" for="inStock">In Stock</label>
              <label class="admin-toggle">
                <input type="checkbox" id="inStock" name="inStock" <%= !product || product.inStock ? 'checked' : '' %>>
                <span class="admin-toggle-slider"></span>
              </label>
            </div>
            <div class="admin-toggle-row">
              <label class="admin-toggle-label" for="featured">Featured on Homepage</label>
              <label class="admin-toggle">
                <input type="checkbox" id="featured" name="featured" <%= product && product.featured ? 'checked' : '' %>>
                <span class="admin-toggle-slider"></span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <div class="admin-form-actions">
        <button type="submit" class="btn btn-terracotta admin-save-btn">
          <%= product ? 'Save Changes' : 'Add Product' %>
        </button>
        <a href="/admin/products" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
<script>
function removeExistingImage(btn, idx) {
  const thumb = btn.closest('.admin-image-thumb');
  thumb.style.opacity = '0.3';
  thumb.style.pointerEvents = 'none';
  const field = document.getElementById('removedImages');
  const current = field.value ? field.value.split(',') : [];
  current.push(idx);
  field.value = current.join(',');
}
</script>
</body>
</html>
