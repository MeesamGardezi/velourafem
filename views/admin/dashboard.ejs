<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard — paknits</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Instrument+Sans:wght@0,400;0,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body no-loader">
  <%- include('../partials/admin-nav') %>

  <div class="admin-content">
    <div class="admin-page-header">
      <h1 class="admin-page-title">Dashboard</h1>
      <p class="admin-page-sub">Welcome back to paknits Admin</p>
    </div>

    <!-- Stats Cards -->
    <div class="admin-stats-grid">
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg></div>
        <div class="admin-stat-info">
          <span class="admin-stat-value"><%= products.length %></span>
          <span class="admin-stat-label">Total Products</span>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></div>
        <div class="admin-stat-info">
          <span class="admin-stat-value"><%= orders.length %></span>
          <span class="admin-stat-label">Total Orders</span>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
        <div class="admin-stat-info">
          <span class="admin-stat-value"><%= orders.filter(o => (o.status || 'pending') === 'pending').length %></span>
          <span class="admin-stat-label">Pending Orders</span>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg></div>
        <div class="admin-stat-info">
          <span class="admin-stat-value"><%= catalogues.length %></span>
          <span class="admin-stat-label">Catalogues</span>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg></div>
        <div class="admin-stat-info">
          <span class="admin-stat-value"><%= brands.length %></span>
          <span class="admin-stat-label">Brands</span>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg></div>
        <div class="admin-stat-info">
          <span class="admin-stat-value"><%= products.filter(p => p.featured).length %></span>
          <span class="admin-stat-label">Featured Products</span>
        </div>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="admin-quick-links">
      <h2 class="admin-section-title">Quick Actions</h2>
      <div class="admin-quick-grid">
        <a href="/admin/orders" class="admin-quick-card">
          <span class="admin-quick-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></span>
          <span>Manage Orders</span>
        </a>
        <a href="/admin/products/new" class="admin-quick-card">
          <span class="admin-quick-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
          <span>Add New Product</span>
        </a>
        <a href="/admin/catalogues" class="admin-quick-card">
          <span class="admin-quick-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg></span>
          <span>Upload Catalogue</span>
        </a>
        <a href="/admin/brands" class="admin-quick-card">
          <span class="admin-quick-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg></span>
          <span>Manage Brands</span>
        </a>
        <a href="/products" class="admin-quick-card" target="_blank">
          <span class="admin-quick-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg></span>
          <span>View Shop</span>
        </a>
        <a href="/" class="admin-quick-card" target="_blank">
          <span class="admin-quick-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg></span>
          <span>View Website</span>
        </a>
      </div>
    </div>

    <!-- Recent Orders -->
    <% if (orders.length) { %>
    <div class="admin-recent" style="margin-bottom:32px">
      <div class="admin-section-header">
        <h2 class="admin-section-title">Recent Orders</h2>
        <a href="/admin/orders" class="admin-view-all">View All →</a>
      </div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Customer</th>
              <th>Date</th>
              <th>Total</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% orders.slice(0, 5).forEach(function(o) { %>
              <tr>
                <td><code style="font-size:0.82rem"><%= o.orderId %></code></td>
                <td><%= o.name %><br><small style="color:#9ca3af"><%= o.email %></small></td>
                <td style="font-size:0.82rem"><%= new Date(o.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                <td><strong><%= usd(o.total || 0) %></strong></td>
                <td>
                  <% const sc = {pending:'#fef9c3',confirmed:'#d1fae5',processing:'#dbeafe',shipped:'#ede9fe',delivered:'#bbf7d0',cancelled:'#fee2e2'}; %>
                  <% const tc = {pending:'#92400e',confirmed:'#065f46',processing:'#1e40af',shipped:'#5b21b6',delivered:'#14532d',cancelled:'#991b1b'}; %>
                  <span style="display:inline-block;padding:3px 10px;border-radius:20px;font-size:0.72rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:<%= sc[o.status||'pending'] %>;color:<%= tc[o.status||'pending'] %>"><%= o.status || 'pending' %></span>
                </td>
                <td class="admin-actions">
                  <a href="/admin/orders/<%= o.firestoreId %>" class="admin-btn-edit">View</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <!-- Recent Products -->
    <div class="admin-recent">
      <div class="admin-section-header">
        <h2 class="admin-section-title">Recent Products</h2>
        <a href="/admin/products" class="admin-view-all">View All →</a>
      </div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Image</th>
              <th>Title</th>
              <th>Category</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.slice(0, 5).forEach(function(p) { %>
              <tr>
                <td><img src="<%= p.image %>" alt="<%= p.title %>" class="admin-table-img"></td>
                <td class="admin-table-title"><%= p.title %></td>
                <td><span class="admin-tag"><%= p.category %></span></td>
                <td><%= priceUsd(p.price) %></td>
                <td>
                  <span class="admin-stock-badge admin-stock-<%= p.inStock ? 'in' : 'out' %>">
                    <%= p.inStock ? 'In Stock' : 'Out of Stock' %>
                  </span>
                </td>
                <td class="admin-actions">
                  <a href="/admin/products/<%= p.id %>/edit" class="admin-btn-edit">Edit</a>
                  <form action="/admin/products/<%= p.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this product?')">
                    <button type="submit" class="admin-btn-delete">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
