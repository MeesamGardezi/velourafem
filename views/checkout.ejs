<% const pageTitle = 'Checkout — ' + content.brand.name; %>
<% const pageDescription = 'Complete your order securely.'; %>
<%- include('partials/shop-head') %>

<%- include('partials/nav') %>

<main class="checkout-main">
  <!-- Breadcrumb -->
  <nav class="breadcrumb shop-breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">
      <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 2l4 4-4 4"/></svg>
    </span>
    <a href="/cart">Cart</a>
    <span class="breadcrumb-sep">
      <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 2l4 4-4 4"/></svg>
    </span>
    <span class="breadcrumb-current">Checkout</span>
  </nav>

  <div class="checkout-inner">
    <!-- Progress Steps -->
    <div class="checkout-progress">
      <div class="checkout-step completed">
        <span class="checkout-step-num">1</span>
        <span class="checkout-step-label">Cart</span>
      </div>
      <div class="checkout-step-line active"></div>
      <div class="checkout-step active">
        <span class="checkout-step-num">2</span>
        <span class="checkout-step-label">Checkout</span>
      </div>
      <div class="checkout-step-line"></div>
      <div class="checkout-step">
        <span class="checkout-step-num">3</span>
        <span class="checkout-step-label">Confirmation</span>
      </div>
    </div>

    <div class="checkout-header">
      <p class="section-eyebrow">Secure Checkout</p>
      <h1 class="checkout-title">Complete Your <em class="script-heading">Order</em></h1>
    </div>

    <% if (error) { %>
      <div class="checkout-error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <%= error %>
      </div>
    <% } %>

    <div class="checkout-layout">
      <!-- Form -->
      <form action="/checkout" method="POST" class="checkout-form">
        <!-- Contact Info -->
        <div class="checkout-section">
          <h2 class="checkout-section-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Contact Information
          </h2>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Full Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required placeholder="Your full name">
            </div>
            <div class="form-group">
              <label for="email">Email Address <span class="required">*</span></label>
              <input type="email" id="email" name="email" required placeholder="you@example.com">
            </div>
          </div>
          <div class="form-group">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" placeholder="+92 300 0000000">
          </div>
        </div>

        <!-- Shipping -->
        <div class="checkout-section">
          <h2 class="checkout-section-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            Shipping Address
          </h2>
          <div class="form-group">
            <label for="address">Street Address <span class="required">*</span></label>
            <input type="text" id="address" name="address" required placeholder="House #, Street, Area">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="city">City <span class="required">*</span></label>
              <input type="text" id="city" name="city" required placeholder="Karachi">
            </div>
            <div class="form-group">
              <label for="postalCode">Postal Code</label>
              <input type="text" id="postalCode" name="postalCode" placeholder="75500">
            </div>
          </div>
        </div>

        <!-- Payment -->
        <div class="checkout-section">
          <h2 class="checkout-section-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            Payment Method
          </h2>
          <div class="payment-options">
            <label class="payment-option">
              <input type="radio" name="paymentMethod" value="card" checked>
              <div class="payment-option-content">
                <span class="payment-icon">💳</span>
                <div>
                  <p class="payment-name">Credit / Debit Card</p>
                  <p class="payment-note">Secure payment via Paddle</p>
                </div>
                <div class="payment-check"></div>
              </div>
            </label>
          </div>
        </div>

        <button type="submit" class="btn btn-terracotta checkout-submit-btn">
          Place Order — <%= usd(totals.total) %>
        </button>
        <p class="checkout-security-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Your information is secure and encrypted
        </p>
      </form>

      <!-- Order Summary -->
      <div class="checkout-summary">
        <h2 class="checkout-summary-title">Your Order</h2>
        <div class="checkout-items">
          <% items.forEach(function(item) { %>
            <div class="checkout-item">
              <div class="checkout-item-img-wrap">
                <img src="<%= item.image %>" alt="<%= item.title %>" class="checkout-item-img">
                <span class="checkout-item-qty-badge"><%= item.qty %></span>
              </div>
              <div class="checkout-item-info">
                <p class="checkout-item-title"><%= item.title %></p>
                <p class="checkout-item-meta"><%= item.meta %></p>
              </div>
              <span class="checkout-item-price"><%= priceUsd(item.price * item.qty) %></span>
            </div>
          <% }); %>
        </div>
        <div class="checkout-summary-totals">
          <div class="cart-summary-row">
            <span>Subtotal</span>
            <span><%= usd(totals.markedUpTotal) %></span>
          </div>
          <div class="cart-summary-row">
            <span>Shipping<%= totals.countryName ? ' to ' + totals.countryName : '' %></span>
            <% if (totals.delivery > 0) { %>
              <span><%= usd(totals.delivery) %></span>
            <% } else { %>
              <span class="cart-free-shipping">Free</span>
            <% } %>
          </div>
          <div class="cart-summary-divider"></div>
          <div class="cart-summary-row cart-summary-total">
            <span>Total</span>
            <span><%= usd(totals.total) %></span>
          </div>
        </div>
        <a href="/cart" class="checkout-edit-link">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 2L4 7l6 5"/></svg>
          Edit Cart
        </a>
      </div>
    </div>
  </div>
</main>

<% if (paddleClientToken) { %>
<script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
<script>
(function() {
  // Initialise Paddle
  // <% if (paddleEnv === 'sandbox') { %>
  // Paddle.Environment.set('sandbox');
  // <% } %>
  Paddle.Initialize({ token: '<%= paddleClientToken %>' });

  const form = document.querySelector('.checkout-form');
  if (!form) return;

  form.addEventListener('submit', async function(e) {
    const method = form.querySelector('input[name="paymentMethod"]:checked');
    if (!method || method.value !== 'card') return; // let COD/bank submit normally

    e.preventDefault();
    const btn = form.querySelector('.checkout-submit-btn');
    btn.disabled = true;
    btn.textContent = 'Processing…';

    try {
      const body = {
        name: form.name.value,
        email: form.email.value,
        phone: form.phone ? form.phone.value : '',
        address: form.address.value,
        city: form.city.value,
        postalCode: form.postalCode ? form.postalCode.value : '',
      };
      const res = await fetch('/api/paddle/create-transaction', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Payment failed');

      Paddle.Checkout.open({
        transactionId: data.transactionId,
        settings: {
          displayMode: 'overlay',
          theme: 'light',
          successUrl: window.location.origin + '/checkout/success',
        },
        customer: {
          email: form.email.value,
        },
      });

      // Listen for checkout events
      Paddle.Checkout.on('checkout.completed', async function() {
        const completeRes = await fetch('/api/paddle/complete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const completeData = await completeRes.json();
        if (completeData.success) {
          window.location.href = completeData.redirect;
        }
      });

      Paddle.Checkout.on('checkout.closed', function() {
        btn.disabled = false;
        btn.textContent = 'Place Order — <%= usd(totals.total) %>';
      });
    } catch (err) {
      console.error('Paddle checkout error:', err);
      btn.disabled = false;
      btn.textContent = 'Place Order — <%= usd(totals.total) %>';
      alert(err.message || 'Failed to start payment. Please try again.');
    }
  });
})();
</script>
<% } %>

<%- include('partials/footer') %>
<%- include('partials/shop-foot') %>
