<% const pageTitle = product.title + ' — ' + content.brand.name; %>
<% const pageDescription = product.desc; %>
<%- include('partials/shop-head') %>

<%- include('partials/nav') %>

<main class="pdp-main">
  <!-- Breadcrumb -->
  <% const sep = '<span class="breadcrumb-sep"><svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 2l4 4-4 4"/></svg></span>'; %>
  <nav class="breadcrumb pdp-breadcrumb">
    <a href="/">Home</a>
    <%- sep %>
    <% if (typeof brand !== 'undefined' && brand) { %>
      <a href="/brands/<%= brand.id %>"><%= brand.name %></a>
      <% if (product.category) { %>
        <%- sep %>
        <a href="/brands/<%= brand.id %>?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a>
      <% } %>
    <% } else { %>
      <a href="/products">Shop</a>
      <% if (product.category) { %>
        <%- sep %>
        <a href="/products?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a>
      <% } %>
    <% } %>
    <%- sep %>
    <span class="breadcrumb-current"><%= product.title %></span>
  </nav>

  <!-- Product Detail -->
  <div class="pdp-grid">
    <!-- Image Column -->
    <div class="pdp-gallery">
      <% const allImages = (product.images && product.images.length) ? product.images : [product.image]; %>
      <div class="pdp-image-wrap">
        <div class="pdp-image-inner">
          <img
            id="pdpMainImage"
            src="<%= allImages[0] %>"
            alt="<%= product.title %>"
            class="pdp-image"
            onerror="this.onerror=null; this.parentElement.classList.add('img-error');"
            loading="eager"
          >
          <!-- Fallback shown on error -->
          <div class="pdp-image-fallback">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            <span>Image unavailable</span>
          </div>
        </div>
        <% if (product.badge) { %>
          <span class="badge badge--<%= product.badgeStyle %> pdp-badge"><%= product.badge %></span>
        <% } %>
        <!-- Zoom hint -->
        <div class="pdp-zoom-hint">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
          <span>Hover to zoom</span>
        </div>
      </div>

      <% if (allImages.length > 1) { %>
        <div class="pdp-thumbnails">
          <% allImages.forEach(function(img, idx) { %>
            <button class="pdp-thumb <%= idx === 0 ? 'active' : '' %>" onclick="switchImage(this, '<%= img %>')" type="button">
              <img src="<%= img %>" alt="<%= product.title %> — Image <%= idx + 1 %>" loading="lazy">
            </button>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Info Column -->
    <div class="pdp-info">
      <div class="pdp-info-inner">
        <div class="pdp-info-top">
          <p class="pdp-category"><%= product.category %></p>
          <h1 class="pdp-title"><%= product.title %></h1>
          <% if (product.meta) { %>
            <p class="pdp-meta"><%= product.meta %></p>
          <% } %>
        </div>

        <div class="pdp-divider"></div>

        <div class="pdp-price-block">
          <p class="pdp-price"><%= priceUsd(product.price) %></p>
          <span class="pdp-stock <%= product.inStock ? 'in-stock' : 'out-stock' %>">
            <span class="pdp-stock-dot"></span>
            <%= product.inStock ? 'In Stock' : 'Out of Stock' %>
          </span>
        </div>

        <p class="pdp-desc"><%= product.desc %></p>

        <% if (product.details) { %>
          <div class="pdp-details-section">
            <button class="pdp-details-toggle" onclick="this.parentElement.classList.toggle('open')">
              <span>Product Details</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 5l5 4 5-4"/></svg>
            </button>
            <div class="pdp-details-content">
              <p class="pdp-details"><%= product.details %></p>
            </div>
          </div>
        <% } %>

        <form action="/cart/add" method="POST" class="pdp-add-form">
          <input type="hidden" name="id" value="<%= product.id %>">
          <div class="pdp-qty-row">
            <label for="qty" class="pdp-qty-label">Quantity</label>
            <div class="pdp-qty-wrap">
              <button type="button" class="qty-btn" id="qty-minus">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 6h8"/></svg>
              </button>
              <input type="number" name="qty" id="qty" value="1" min="1" max="10" class="qty-input" readonly>
              <button type="button" class="qty-btn" id="qty-plus">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2v8M2 6h8"/></svg>
              </button>
            </div>
          </div>
          <button type="submit" class="pdp-add-btn" <%= !product.inStock ? 'disabled' : '' %>>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
            <span><%= product.inStock ? 'Add to Cart' : 'Out of Stock' %></span>
          </button>
        </form>

        <div class="pdp-trust-badges">
          <div class="pdp-trust-item">
            <div class="pdp-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span>Secure Checkout</span>
          </div>
          <div class="pdp-trust-item">
            <div class="pdp-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <span>Free Shipping</span>
          </div>
          <div class="pdp-trust-item">
            <div class="pdp-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <span>Premium Quality</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Related Products -->
  <% if (related.length > 0) { %>
    <section class="related-section">
      <div class="related-header">
        <p class="section-eyebrow">You May Also Like</p>
        <h2 class="related-title">Complete the <em class="script-heading">Look</em></h2>
      </div>
      <div class="shop-grid related-grid">
        <% related.forEach(function(p) { %>
          <article class="shop-card">
            <a href="/products/<%= p.id %>" class="shop-card-img-link">
              <div class="shop-card-img">
                <img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy">

                <% if (p.badge) { %>
                  <span class="badge badge--<%= p.badgeStyle %> shop-badge"><%= p.badge %></span>
                <% } %>
              </div>
            </a>
            <div class="shop-card-body">
              <p class="shop-card-category"><%= p.category %></p>
              <h3 class="shop-card-title"><a href="/products/<%= p.id %>"><%= p.title %></a></h3>
              <div class="shop-card-footer">
                <span class="shop-card-price"><%= priceUsd(p.price) %></span>
                <form action="/cart/add" method="POST">
                  <input type="hidden" name="id" value="<%= p.id %>">
                  <input type="hidden" name="qty" value="1">
                  <button type="submit" class="btn-add-cart">Add to Cart</button>
                </form>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </section>
  <% } %>
</main>

<%- include('partials/footer') %>
<%- include('partials/shop-foot') %>
<script>
function switchImage(thumb, src) {
  document.getElementById('pdpMainImage').src = src;
  document.querySelectorAll('.pdp-thumb').forEach(t => t.classList.remove('active'));
  thumb.classList.add('active');
}
</script>
