# ──────────────────────────────────────────────────────────────
# paknits — Environment Variables
# Copy this file to .env and fill in your Firebase credentials.
# ──────────────────────────────────────────────────────────────

# Server
PORT=3000

# ── Firebase (Admin SDK) ───────────────────────────────────────
# Get these from Firebase Console → Project Settings → Service Accounts
# → Generate New Private Key  (downloads a JSON file)
# Then copy the values below from that JSON:

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Firebase Storage ───────────────────────────────────────────
# Usually  <project-id>.appspot.com  or  <project-id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ── Gemini (optional — enables AI-assisted pagination detection) ─
# When set, the scraper will use Gemini 2.5 Pro to detect next-page URLs
# on sites whose pagination patterns aren't recognised by heuristics.
# Leave blank to rely on heuristics only.
GEMINI_API_KEY=
